<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ProductsImport</RootNamespace>
    <AssemblyName>ProductsImport</AssemblyName>
    <ApplicationIcon />
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirects>true</GenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <!-- Excel/CSV reading: NPOI is a pure-managed, self-contained reader/writer with no native
         Interop/Excel-installation dependency, keeping the deployed footprint small. -->
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Password encryption (DPAPI) and connection-profile JSON storage use framework assemblies
         that ship with .NET Framework, so no extra NuGet packages are needed for them. -->
    <Reference Include="System.Security" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
